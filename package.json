{
  "name": "datacenter-market-v1",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:preview": "cross-env NODE_ENV=development tsx server/_core/index.ts",
    "build": "vite build && tsx scripts/generate-seo-files.ts && tsx scripts/prerender.ts && esbuild server/_core/index.ts --platform=node --packages=external --external:*/vite.config --bundle --format=esm --outfile=dist/index.js && esbuild server/db-preflight.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/db-preflight.js",
    "seo:files": "tsx scripts/generate-seo-files.ts",
    "prerender": "tsx scripts/prerender.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "audit:prod": "pnpm audit --prod",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm db:migrate",
    "db:preflight": "tsx server/db-preflight.ts",
    "db:seed": "tsx server/seed.ts",
    "db:purge": "tsx server/purge-leads.ts",
    "db:cancel-stale": "tsx server/cancel-stale-orders.ts",
    "db:telemetry": "tsx server/simulate-telemetry.ts --daemon",
    "integration-check": "tsx server/integration-check.ts",
    "stripe:smoke": "tsx server/stripe-smoke.ts"
  },
