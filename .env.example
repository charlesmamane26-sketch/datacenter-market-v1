# =============================================================================
# DatacenterMarket — environment variables
# Copy to `.env` and fill in. NEVER commit a real .env.
#
# IMPORTANT: variables prefixed with VITE_ are inlined into the client bundle at
# BUILD time (by Vite). They must be present when you run `pnpm build`, not just
# at runtime. All others are read by the server at runtime.
# =============================================================================

# ---- Runtime (server) ----
# MySQL / TiDB connection string
DATABASE_URL="mysql://user:password@host:3306/datacenter_market"
# Secret used to sign session cookies
JWT_SECRET="change-me-to-a-long-random-string"
# Manus OAuth backend base URL
OAUTH_SERVER_URL="https://oauth.example.com"
# Project owner (granted the "admin" role on first sign-in)
OWNER_OPEN_ID=""
OWNER_NAME=""
# Manus built-in APIs (LLM, storage, notifications) — server side
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
# Stripe (payments) — server side. Configure a webhook to POST /api/stripe/webhook
# (event: checkout.session.completed) and put its signing secret below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# HTTP port (optional, defaults to 3000)
PORT=3000
# RGPD lead retention window in days for `pnpm db:purge` (optional, default 730 = ~24 months)
LEAD_RETENTION_DAYS=730
# Cancel abandoned (pending/unpaid) orders older than this many hours via `pnpm db:cancel-stale` (optional, default 24)
STALE_ORDER_HOURS=24

# Error Monitoring
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# ---- Build time (client / VITE_*) ----
# Manus OAuth application id and login portal URL (used to build the login URL)
VITE_APP_ID=""
VITE_OAUTH_PORTAL_URL="https://login.example.com"
# Manus built-in APIs — frontend access
VITE_FRONTEND_FORGE_API_URL=""
VITE_FRONTEND_FORGE_API_KEY=""
# Optional analytics (Umami) — leave empty to disable
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
