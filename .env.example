# =============================================================================
# DatacenterMarket — environment variables
# Copy to `.env` and fill in. NEVER commit a real .env.
#
# IMPORTANT: variables prefixed with VITE_ are inlined into the client bundle at
# BUILD time (by Vite). They must be present when you run `pnpm build`, not just
# at runtime. All others are read by the server at runtime.
# =============================================================================

# ---- Runtime (server) ----
# MySQL / TiDB connection string
DATABASE_URL="mysql://user:password@host:3306/datacenter_market"
# Secret used to sign session cookies
JWT_SECRET="change-me-to-a-long-random-string"
# Manus OAuth backend base URL
OAUTH_SERVER_URL="https://oauth.example.com"
# Project owner (granted the "admin" role on first sign-in)
OWNER_OPEN_ID=""
# Manus built-in APIs (LLM, storage, notifications) — server side
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
# Stripe (payments) — server side. Configure a webhook to POST /api/stripe/webhook
# (event: checkout.session.completed) and put its signing secret below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Safety acknowledgement required for sk_live_ and rk_live_ keys. Enable only
# after contractual, provider, webhook and end-to-end go-live checks.
STRIPE_LIVE_PAYMENTS_ENABLED="false"
# Command-local opt-in for `pnpm stripe:smoke`. The command also requires an
# sk_test_ or rk_test_ key and refuses every live/unknown key. Leave false in long-lived environments.
STRIPE_SMOKE_TEST_ENABLED="false"
# Public origin of the deployment, e.g. https://app.example.com — REQUIRED in
# production: trusted source for Stripe success/cancel URLs and OAuth state
# validation (the server refuses those flows without it).
PUBLIC_BASE_URL=""
# Extra origins to allow in the Content-Security-Policy, space-separated.
# REQUIRED when VITE_SENTRY_DSN (Sentry ingest origin) or analytics are used.
CSP_EXTRA_ORIGINS=""
# Shared rate-limit store + server-side session revocation. Optional at a single
# instance (in-memory fallback); REQUIRED when running several instances.
REDIS_URL=""
# Transactional email API (order confirmed, infra ready). Unset = emails are
# logged but never delivered.
EMAIL_API_URL=""
EMAIL_API_KEY=""
# Enables POST /api/telemetry/:orderId (provider agents push GPU/CPU metrics).
# Unset = the route answers 503.
TELEMETRY_INGEST_KEY=""
# Telemetry alert thresholds in percent (optional, defaults 95/95/90)
# ALERT_GPU_USAGE_PCT=95
# ALERT_CPU_USAGE_PCT=95
# ALERT_GPU_MEMORY_PCT=90
# Number of reverse proxies in front of the app in production (optional, default 1
# — correct for Render/Heroku-style hosts; add +1 per extra proxy, e.g. Cloudflare).
# TRUST_PROXY_HOPS=1
# Readiness query timeout in milliseconds (optional, default 5000).
# DB_READINESS_TIMEOUT_MS=5000
# Read-only startup/pre-deploy database check timeout (optional, default 10000).
# DB_PREFLIGHT_TIMEOUT_MS=10000
# HTTP port (optional, defaults to 3000)
PORT=3000
# RGPD lead retention window in days for `pnpm db:purge` (optional, default 730 = ~24 months)
LEAD_RETENTION_DAYS=730
# Cancel abandoned (pending/unpaid) orders older than this many hours via `pnpm db:cancel-stale` (optional, default 24)
STALE_ORDER_HOURS=24

# Error Monitoring
SENTRY_DSN=""
VITE_SENTRY_DSN=""
# Values between 0 and 1. Defaults in code: traces 0.1, session replay 0,
# error replay 0.1. Keep replay sampling proportionate to RGPD needs.
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.02"
VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0.1"

# ---- Build time (client / VITE_*) ----
# Domaine canonique public du site (SEO : canonical, Open Graph, sitemap, robots).
# Utilisé au build par le client ET par les scripts seo:files / prerender.
VITE_SITE_URL="https://www.datacentermarket.fr"
# Manus OAuth application id and login portal URL (used to build the login URL)
VITE_APP_ID=""
VITE_OAUTH_PORTAL_URL="https://login.example.com"
# Manus built-in APIs — frontend access
VITE_FRONTEND_FORGE_API_URL=""
VITE_FRONTEND_FORGE_API_KEY=""
# Optional analytics (Umami) — leave empty to disable
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
